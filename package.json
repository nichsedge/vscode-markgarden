{
  "name": "obsidian-notes",
  "displayName": "Obsidian Notes Integration",
  "description": "Obsidian-like daily notes, template insertion, Wikilinks navigation, category/tag management, and interactive graph view for digital garden workspaces.",
  "version": "1.4.0",
  "publisher": "al",
  "author": {
    "name": "Al"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nichsedge/vscode-obsidian-notes.git"
  },
  "bugs": {
    "url": "https://github.com/nichsedge/vscode-obsidian-notes/issues"
  },
  "homepage": "https://github.com/nichsedge/vscode-obsidian-notes#readme",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Visualization"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "scripts": {
    "vscode:prepublish": "",
    "package": "vsce package",
    "publish": "vsce publish",
    "lint": "eslint .",
    "test": "node test/runTests.js"
  },
  "devDependencies": {
    "@types/node": "^16.11.7",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^2.15.0",
    "eslint": "^8.28.0"
  },
  "contributes": {
    "markdown.markdownItPlugins": true,
    "viewsContainers": {
      "activitybar": [
        {
          "id": "obsidian-notes-view",
          "title": "Obsidian Notes",
          "icon": "resources/obsidian.svg"
        }
      ]
    },
    "views": {
      "obsidian-notes-view": [
        {
          "id": "obsidian-notes-backlinks",
          "name": "Backlinks"
        },
        {
          "id": "obsidian-notes-tags",
          "name": "Tags"
        },
        {
          "id": "obsidian-notes-categories",
          "name": "Categories"
        },
        {
          "id": "obsidian-notes-digital-garden",
          "name": "Digital Garden"
        }
      ]
    },
    "commands": [
      {
        "command": "obsidian-notes.openGraphView",
        "title": "Open Graph View",
        "category": "Obsidian Notes",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "obsidian-notes.openLocalGraphView",
        "title": "Open Local Graph View",
        "category": "Obsidian Notes",
        "icon": "$(references)"
      },
      {
        "command": "obsidian-notes.createDailyNote",
        "title": "Create Daily Note",
        "category": "Obsidian Notes"
      },
      {
        "command": "obsidian-notes.insertTemplate",
        "title": "Insert Template",
        "category": "Obsidian Notes"
      },
      {
        "command": "obsidian-notes.openLinkAtCursor",
        "title": "Follow Link Under Cursor",
        "category": "Obsidian Notes"
      },
      {
        "command": "obsidian-notes.addTag",
        "title": "Add Tag to Current Note",
        "category": "Obsidian Notes"
      },
      {
        "command": "obsidian-notes.removeTag",
        "title": "Remove Tag from Current Note",
        "category": "Obsidian Notes"
      },
      {
        "command": "obsidian-notes.findNotesByTag",
        "title": "Find Notes by Tag",
        "category": "Obsidian Notes"
      },
      {
        "command": "obsidian-notes.renameTag",
        "title": "Rename Tag Across Workspace",
        "category": "Obsidian Notes"
      },
      {
        "command": "obsidian-notes.addCategory",
        "title": "Add Category to Current Note",
        "category": "Obsidian Notes"
      },
      {
        "command": "obsidian-notes.removeCategory",
        "title": "Remove Category from Current Note",
        "category": "Obsidian Notes"
      },
      {
        "command": "obsidian-notes.findNotesByCategory",
        "title": "Find Notes by Category",
        "category": "Obsidian Notes"
      },
      {
        "command": "obsidian-notes.renameCategory",
        "title": "Rename Category Across Workspace",
        "category": "Obsidian Notes"
      },
      {
        "command": "obsidian-notes.refreshIndex",
        "title": "Refresh Notes Index",
        "category": "Obsidian Notes"
      },
      {
        "command": "obsidian-notes.togglePinBacklinks",
        "title": "Toggle Pin Note",
        "category": "Obsidian Notes",
        "icon": "$(pin)"
      },
      {
        "command": "obsidian-notes.refreshBacklinks",
        "title": "Refresh Backlinks",
        "category": "Obsidian Notes",
        "icon": "$(refresh)"
      },
      {
        "command": "obsidian-notes.convertUnlinkedMentionToWikilink",
        "title": "Convert to Wikilink",
        "category": "Obsidian Notes",
        "icon": "$(link)"
      },
      {
        "command": "obsidian-notes.extractSelectionToNote",
        "title": "Extract Selection to Note (Zettelkasten Refactor)",
        "category": "Obsidian Notes",
        "icon": "$(symbol-file)"
      },
      {
        "command": "obsidian-notes.addProperty",
        "title": "Add / Set Frontmatter Property",
        "category": "Obsidian Notes",
        "icon": "$(list-selection)"
      },
      {
        "command": "obsidian-notes.formatFrontmatter",
        "title": "Format Frontmatter",
        "category": "Obsidian Notes"
      },
      {
        "command": "obsidian-notes.renameProperty",
        "title": "Rename Property Across Workspace",
        "category": "Obsidian Notes"
      },
      {
        "command": "obsidian-notes.convertInlineTagsToFrontmatter",
        "title": "Convert Inline Tags to Frontmatter",
        "category": "Obsidian Notes"
      },
      {
        "command": "obsidian-notes.syncTitleWithFilename",
        "title": "Sync Note Title with Filename",
        "category": "Obsidian Notes"
      },
      {
        "command": "obsidian-notes.togglePublishStatus",
        "title": "Toggle Publish Status",
        "category": "Obsidian Notes",
        "icon": "$(globe)"
      },
      {
        "command": "obsidian-notes.setGrowthStage",
        "title": "Set Growth Stage (🌱/🌿/🌲)",
        "category": "Obsidian Notes",
        "icon": "$(symbol-event)"
      },
      {
        "command": "obsidian-notes.runGardenAudit",
        "title": "Run Digital Garden Audit",
        "category": "Obsidian Notes",
        "icon": "$(pulse)"
      },
      {
        "command": "obsidian-notes.refreshDigitalGarden",
        "title": "Refresh Digital Garden",
        "category": "Obsidian Notes",
        "icon": "$(refresh)"
      },
      {
        "command": "obsidian-notes.insertCallout",
        "title": "Insert Obsidian Callout / Admonition",
        "category": "Obsidian Notes",
        "icon": "$(notebook)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "obsidian-notes.openGraphView",
          "when": "editorLangId == markdown",
          "group": "navigation@1"
        },
        {
          "command": "obsidian-notes.openLocalGraphView",
          "when": "editorLangId == markdown",
          "group": "navigation@2"
        }
      ],
      "view/title": [
        {
          "command": "obsidian-notes.togglePinBacklinks",
          "when": "view == obsidian-notes-backlinks",
          "group": "navigation@1"
        },
        {
          "command": "obsidian-notes.refreshBacklinks",
          "when": "view == obsidian-notes-backlinks",
          "group": "navigation@2"
        },
        {
          "command": "obsidian-notes.openGraphView",
          "when": "view == obsidian-notes-tags || view == obsidian-notes-categories",
          "group": "navigation@1"
        },
        {
          "command": "obsidian-notes.refreshIndex",
          "when": "view == obsidian-notes-tags || view == obsidian-notes-categories",
          "group": "navigation@2"
        },
        {
          "command": "obsidian-notes.refreshDigitalGarden",
          "when": "view == obsidian-notes-digital-garden",
          "group": "navigation@1"
        },
        {
          "command": "obsidian-notes.runGardenAudit",
          "when": "view == obsidian-notes-digital-garden",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "obsidian-notes.convertUnlinkedMentionToWikilink",
          "when": "view == obsidian-notes-backlinks && viewItem == unlinkedMentionSnippet",
          "group": "inline"
        },
        {
          "command": "obsidian-notes.renameTag",
          "when": "viewItem == obsidianTag",
          "group": "inline"
        },
        {
          "command": "obsidian-notes.renameCategory",
          "when": "viewItem == obsidianCategory",
          "group": "inline"
        }
      ],
      "editor/context": [
        {
          "command": "obsidian-notes.insertCallout",
          "when": "editorTextFocus && editorLangId == markdown",
          "group": "1_modification@1"
        },
        {
          "command": "obsidian-notes.togglePublishStatus",
          "when": "editorTextFocus && editorLangId == markdown",
          "group": "1_modification@2"
        },
        {
          "command": "obsidian-notes.setGrowthStage",
          "when": "editorTextFocus && editorLangId == markdown",
          "group": "1_modification@3"
        },
        {
          "command": "obsidian-notes.extractSelectionToNote",
          "when": "editorHasSelection && editorTextFocus && editorLangId == markdown",
          "group": "1_modification@4"
        },
        {
          "command": "obsidian-notes.openLinkAtCursor",
          "when": "editorTextFocus && editorLangId == markdown",
          "group": "navigation"
        },
        {
          "command": "obsidian-notes.openLocalGraphView",
          "when": "editorTextFocus && editorLangId == markdown",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "obsidian-notes.openGraphView",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g"
      },
      {
        "command": "obsidian-notes.createDailyNote",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d"
      },
      {
        "command": "obsidian-notes.insertTemplate",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      },
      {
        "command": "obsidian-notes.insertCallout",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "obsidian-notes.togglePublishStatus",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "obsidian-notes.openLinkAtCursor",
        "key": "alt+enter",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "obsidian-notes.extractSelectionToNote",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorHasSelection && editorTextFocus && editorLangId == markdown"
      }
    ],
    "configuration": {
      "title": "Obsidian Notes",
      "properties": {
        "obsidian-notes.hoverPreviewEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Show rich markdown preview tooltip when hovering over [[wikilinks]], ![[embeds]], headings, and block references."
        },
        "obsidian-notes.hoverPreviewMaxLength": {
          "type": "number",
          "default": 1200,
          "description": "Maximum character length for hover preview body before truncation."
        },
        "obsidian-notes.templatesFolder": {
          "type": "string",
          "default": "templates",
          "description": "Path to the templates folder relative to the workspace root."
        },
        "obsidian-notes.excludeTemplatesFromIndex": {
          "type": "boolean",
          "default": true,
          "description": "Exclude templates folder from note graph, backlinks, and wikilink autocompletion so template drafts do not pollute the workspace index."
        },
        "obsidian-notes.dailyNotesFolder": {
          "type": "string",
          "default": "",
          "description": "Path to the daily notes folder relative to the workspace root (e.g. '', 'journal', etc.)."
        },
        "obsidian-notes.dailyNoteTemplate": {
          "type": "string",
          "default": "daily.md",
          "description": "Name of the daily note template file (must exist within the templates folder)."
        },
        "obsidian-notes.dateFormat": {
          "type": "string",
          "default": "YYYY-MM-DD",
          "description": "Format for today's daily note filename (without .md extension)."
        },
        "obsidian-notes.openDailyNoteOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Automatically open or create today's daily note on editor startup."
        },
        "obsidian-notes.newNoteFolderStrategy": {
          "type": "string",
          "enum": [
            "root",
            "sameAsCurrent",
            "custom"
          ],
          "default": "root",
          "description": "Where to create new notes when following a non-existent [[wikilink]]: 'root' (workspace root), 'sameAsCurrent' (same directory as active note), or 'custom' (configured in notesFolder)."
        },
        "obsidian-notes.notesFolder": {
          "type": "string",
          "default": "",
          "description": "Custom destination folder path for new notes when newNoteFolderStrategy is set to 'custom'."
        },
        "obsidian-notes.tagPrefix": {
          "type": "string",
          "enum": [
            "frontmatter",
            "inline"
          ],
          "default": "frontmatter",
          "description": "Default placement style when adding tags: 'frontmatter' (YAML frontmatter) or 'inline' (#tag at end of file)."
        },
        "obsidian-notes.excludedTags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "List of tags to exclude from Graph View, Tag tree view, and tag autocompletion (e.g. ['archive', 'daily', 'anime'])."
        },
        "obsidian-notes.excludedFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/.vscode/**",
            "**/dist/**",
            "**/out/**"
          ],
          "description": "Glob patterns of directories to exclude from workspace notes and tag indexing."
        },
        "obsidian-notes.frontmatter.enableCompletions": {
          "type": "boolean",
          "default": true,
          "description": "Enable context-aware IntelliSense completions in YAML frontmatter for properties, tags, categories, wikilinks, and values."
        },
        "obsidian-notes.frontmatter.autoUpdateModifiedDate": {
          "type": "boolean",
          "default": true,
          "description": "Automatically update last modified timestamp in YAML frontmatter on saving markdown notes."
        },
        "obsidian-notes.frontmatter.modifiedDateKey": {
          "type": "string",
          "default": "updated",
          "description": "Frontmatter property key name used for auto-updating modified timestamps (e.g. 'updated', 'modified', 'lastmod')."
        },
        "obsidian-notes.frontmatter.dateFormat": {
          "type": "string",
          "default": "YYYY-MM-DD HH:mm:ss",
          "description": "Date/time format string used when writing timestamps in frontmatter."
        },
        "obsidian-notes.frontmatter.defaultProperties": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "title",
            "date",
            "updated",
            "tags",
            "categories",
            "aliases",
            "status",
            "summary"
          ],
          "description": "List of default property keys suggested in frontmatter completion."
        },
        "obsidian-notes.digitalGarden.publishProperty": {
          "type": "string",
          "default": "publish_external",
          "description": "Frontmatter property key used to determine if a note is published (e.g. 'publish_external', 'publish', 'published')."
        },
        "obsidian-notes.digitalGarden.growthProperty": {
          "type": "string",
          "default": "growth",
          "description": "Frontmatter property key used for note growth stages: seedling 🌱, budding 🌿, evergreen 🌲 (e.g. 'growth', 'stage', 'status')."
        },
        "obsidian-notes.digitalGarden.enableDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Enable editor diagnostics/squiggles for broken wikilinks and public-to-private privacy leaks."
        },
        "obsidian-notes.digitalGarden.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show interactive Growth Stage and Publish Status indicators in the VS Code status bar."
        },
        "obsidian-notes.callouts.enableDecorations": {
          "type": "boolean",
          "default": true,
          "description": "Highlight Obsidian Callouts / Admonitions (> [!note]) in the editor with custom tint and borders."
        }
      }
    }
  }
}

